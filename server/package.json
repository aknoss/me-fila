{
  "name": "me-fila-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:integration:docker": "docker compose -f ../docker-compose.test.yml up -d --wait && vitest run --config vitest.integration.config.ts --coverage; EXIT_CODE=$?; docker compose -f ../docker-compose.test.yml down -v; exit $EXIT_CODE",
    "format": "npx prettier . --write",
    "migrate": "knex migrate:latest --env production",
    "rollback": "knex migrate:rollback --env production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@me-fila/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.17.1",
    "nanoid": "^5.1.5",
    "tsx": "^4.21.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.19.5",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "nodemon": "^3.1.7",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
